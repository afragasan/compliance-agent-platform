# Local development. Copy to .env and adjust.

# Postgres (docker-compose). In AWS, leave DATABASE_URL unset and set DB_SECRET_ARN.
DATABASE_URL=postgresql://cap:cap@localhost:5432/cap
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:cap/rds-xxxxxx

# AWS / Bedrock
AWS_REGION=us-east-1
# Use the cross-region inference profile id (Claude models generally have no
# on-demand throughput on the bare model id). Confirm: aws bedrock list-inference-profiles
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Offline toggle (export in your shell, not read from this file): skip Bedrock and
# return a canned EvaluationResult. Valid values:
#   clear | clear_low | true_match | escalate | escalate_to_analyst | insufficient_data
#   export CAP_FAKE_MODEL=clear

# Screening policy
PROMPT_VERSION=sanctions-eval-v1
CLEAR_CONFIDENCE_THRESHOLD=0.85

# Audit export (S3 Object Lock, `cap audit export`/`verify`/`bucket-config`) — see
# docs/aws-compliance-setup.md for bucket provisioning steps.
# AUDIT_EXPORT_BUCKET=cap-audit-export-<account-id>
AUDIT_EXPORT_PREFIX=screening-audit
# 30 days (1 month) is a POC default. Set per the applicable regulatory retention
# requirement before using this for anything beyond a proof of concept.
AUDIT_RETENTION_DAYS=30
